FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nuTilda;
}

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 4e-05;

boundaryField
{
    inlet
    {
        type            freestream;
        freestreamValue uniform 4e-05;
    }

    outlet
    {
        type            freestream;
        freestreamValue uniform 4e-05;
    }

    topandbottom
    {
        type            freestream;
        freestreamValue uniform 4e-05;
    }

    front
    {
        type            symmetryPlane;
    }

    back
    {
        type            symmetryPlane;
    }

    airfoil
    {
        type            fixedValue;
        value           uniform 0;
    }
}
